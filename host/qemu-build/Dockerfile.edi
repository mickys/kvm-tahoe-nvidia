# Builder for edi (Debian bullseye, glibc 2.31). bullseye is EOL: packages come from archive.debian.org.
# QEMU 11 needs GCC >= 10.4 (bullseye has 10.2) and clang <= 13 rejects some board code, so use clang-19 from apt.llvm.org.
FROM debian:bullseye
ENV DEBIAN_FRONTEND=noninteractive
RUN printf 'deb http://archive.debian.org/debian bullseye main\ndeb http://archive.debian.org/debian-security bullseye-security main\n' > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/* \
 && apt-get -o Acquire::Check-Valid-Until=false update -qq \
 && apt-get install -y -qq build-essential ninja-build pkg-config python3 python3-venv python3-pip \
    libglib2.0-dev libpixman-1-dev libslirp-dev libfdt-dev zlib1g-dev libzstd-dev libaio-dev \
    libcap-ng-dev libattr1-dev libnuma-dev bzip2 flex bison git curl gnupg >/dev/null \
 && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
 && echo 'deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/bullseye/ llvm-toolchain-bullseye-19 main' > /etc/apt/sources.list.d/llvm.list \
 && apt-get -o Acquire::Check-Valid-Until=false update -qq && apt-get install -y -qq clang-19 >/dev/null \
 && pip3 install -q tomli && rm -rf /var/lib/apt/lists/*
# Everything else QEMU can use on a headless KVM host (see build-in-container.sh for the feature list), plus what
# spice-server needs. meson from pip builds spice (QEMU brings its own); cmake
# from pip because libcbor 0.14 needs C23, which bullseye's cmake 3.18 can't enable. lzfse, nettle, gnutls and libcbor are
# missing or too old in bullseye and are built from source in build-in-container.sh.
RUN apt-get -o Acquire::Check-Valid-Until=false update -qq \
 && apt-get install -y -qq file xz-utils python3-pyparsing patchelf libgmp-dev libp11-kit-dev \
    libssl-dev libopus-dev liblz4-dev libjpeg62-turbo-dev libpng-dev libsasl2-dev \
    libusbredirparser-dev libusb-1.0-0-dev libcacard-dev libseccomp-dev liburing-dev \
    libgnutls28-dev nettle-dev libudev-dev libcurl4-gnutls-dev libssh-dev liblzo2-dev libsnappy-dev \
    libfuse3-dev libcapstone-dev libpulse-dev libasound2-dev libbz2-dev libkeyutils-dev \
    libselinux1-dev libpmem-dev libdaxctl-dev libvdeplug-dev librdmacm-dev libibverbs-dev >/dev/null \
 && pip3 install -q meson cmake && rm -rf /var/lib/apt/lists/*
