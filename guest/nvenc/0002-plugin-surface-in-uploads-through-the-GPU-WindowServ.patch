From 17c98ccad049e0f1b9dd4f4e6e5aeafefd720390 Mon Sep 17 00:00:00 2001
From: mickys <micky@nowlive.ro>
Date: Sun, 18 Oct 2026 12:11:45 +0300
Subject: [PATCH] plugin: surface-in uploads through the GPU; WindowServer
 keeps uploaded surfaces mapped

When WindowServer composites a window that was drawn by the CPU (WebKit views, CoreGraphics apps), the plugin copied
the IOSurface's pages into the window's GPU image with the CPU, and the pages were faulted in again for every frame
because WindowServer releases the client's surface each frame. Measured on an RTX 4090 (VM): 15 ms of WindowServer
CPU per frame of a 3158x1816 window.

- GPU upload (default in every process): the locked surface pages are imported as host memory
  (VK_EXT_external_memory_host) and the GPU copies them into the image; falls back to the CPU copy.
  NVMTL_SURFIN_UPLOAD=cpu restores the CPU copy.
- WindowServer keeps the last 32 uploaded surfaces (at most 384 MB) retained, so their pages stay mapped.
  NVMTL_SURFIN_KEEP=1/0 overrides (default: on in WindowServer only).

Safari full-screen CSS animation: 15.0 -> 5.3 ms per upload, WindowServer user CPU 128% -> 30% of a core, display
transactions 24 -> 30 per second. Pixel-exact (CPU-written pattern read back through the GPU).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 plugin/NVMTLObjects.m | 47 ++++++++++++++++++++++++++++++++++++++++++-
 plugin/nvmtl_vk.c     | 31 ++++++++++++++++++++++++++++
 plugin/nvmtl_vk.h     |  1 +
 3 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/plugin/NVMTLObjects.m b/plugin/NVMTLObjects.m
index 2f4067c..47c52b3 100644
--- a/plugin/NVMTLObjects.m
+++ b/plugin/NVMTLObjects.m
@@ -1212,6 +1212,44 @@ static id nvmtl_surface_sync(NVMTLTexture *t) {
         return monitor;
     }
 }
+// How surface-in uploads an IOSurface's pages into its GPU image (bit mask):
+//   2: through the GPU: the locked surface pages are imported as host memory and the GPU copies them (no CPU copy, no
+//      CPU touch of the pages); falls back to the CPU copy. Default on; NVMTL_SURFIN_UPLOAD=cpu turns it off.
+//   1: keep the last uploaded IOSurfaces retained (32, at most 384 MB), so their pages stay mapped from one frame to the
+//      next: WindowServer drops a client's surface every frame, and the pages were faulted in again at each upload
+//      (~15 ms for a 22 MB window in a VM). Default on in WindowServer only; NVMTL_SURFIN_KEEP=1/0 overrides.
+// Non-release builds: /tmp/nvmtl-surfin-mode (re-read every 250 ms) overrides both while it exists.
+static int nvmtl_surfin_mode(void) {
+    static int base = -1;
+    if (base < 0) {
+        const char *u = getenv("NVMTL_SURFIN_UPLOAD"), *k = getenv("NVMTL_SURFIN_KEEP");
+        const int keep = k && *k ? k[0] != '0' : !strcmp(getprogname(), "WindowServer");
+        base = ((u && !strcmp(u, "cpu")) ? 0 : 2) | (keep ? 1 : 0);
+        nvlog("surface-in: %s upload%s in %s", (base & 2) ? "GPU" : "CPU", (base & 1) ? ", uploaded surfaces kept mapped" : "", getprogname());
+    }
+    static uint64_t next; static int file = -1; uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW);
+    if (now >= next) { next = now + 250000000ull; int m = -1; FILE *f = fopen("/tmp/nvmtl-surfin-mode", "r");
+        if (f) { if (fscanf(f, "%d", &m) != 1) m = -1; fclose(f); }
+        if (m != file) nvlog("surface-in mode override %d -> %d (-1 = none, 1 keep surfaces mapped, 2 GPU upload)", file, m);
+        file = m; }
+    return file >= 0 ? file : base; }
+static void nvmtl_surfin_keep(IOSurfaceRef surf) {
+    enum { KEEP_N = 32 }; static const size_t KEEP_BYTES = 384u << 20;
+    static IOSurfaceRef ring[KEEP_N]; static size_t sz[KEEP_N], total; static unsigned at; static pthread_mutex_t lk = PTHREAD_MUTEX_INITIALIZER;
+    const size_t n = IOSurfaceGetAllocSize(surf);
+    if (n > KEEP_BYTES / 4) return;
+    IOSurfaceRef drop[KEEP_N]; unsigned nd = 0;
+    pthread_mutex_lock(&lk);
+    for (unsigned i = 0; i < KEEP_N; i++) if (ring[i] == surf) { pthread_mutex_unlock(&lk); return; }
+    // make room: the slot we take, then the oldest ones until the bytes fit
+    for (unsigned i = 0; i < KEEP_N && (ring[at] || total + n > KEEP_BYTES); i++) {
+        const unsigned v = (at + i) % KEEP_N;
+        if (ring[v] && (v == at || total + n > KEEP_BYTES)) { drop[nd++] = ring[v]; total -= sz[v]; ring[v] = NULL; sz[v] = 0; }
+    }
+    ring[at] = (IOSurfaceRef)CFRetain(surf); sz[at] = n; total += n; at = (at + 1) % KEEP_N;
+    pthread_mutex_unlock(&lk);
+    for (unsigned i = 0; i < nd; i++) CFRelease(drop[i]);
+}
 - (void)nvmtlSurfaceIn {
     NVMTLTexture *r = _parent ? _parent : self;
     if (!r->_surf) return;
@@ -1225,10 +1263,17 @@ static id nvmtl_surface_sync(NVMTLTexture *t) {
           static unsigned ns; if (ns++ < 6 || ns % 2000 == 0) nvlog("item 7: surface-in SKIPPED (shared VRAM current at seed %u): %llu skipped, %llu copied", now, g_surfin_skip, g_surfin_copy);
           return; } }
     uint32_t seed = 0;
+    const int mode = nvmtl_surfin_mode();
+    if (mode & 1) nvmtl_surfin_keep(r->_surf);
     if (IOSurfaceLock(r->_surf, kIOSurfaceLockReadOnly, &seed) != kIOReturnSuccess) { nvlog("G13 surface-in: IOSurfaceLock FAILED"); return; }
     void *base = IOSurfaceGetBaseAddressOfPlane(r->_surf, (uint32_t)r->_plane);
     size_t row = IOSurfaceGetBytesPerRowOfPlane(r->_surf, (uint32_t)r->_plane);
-    int rc = (base && row) ? nvmtl_vk_image_write(r->_q, &r->_i, base, row) : -1;
+    int rc = -1;
+    if ((mode & 2) && base && row) {
+        const size_t off = (size_t)((uint8_t *)base - (uint8_t *)IOSurfaceGetBaseAddress(r->_surf));
+        rc = nvmtl_vk_image_write_host(r->_q, &r->_i, base, row, IOSurfaceGetAllocSize(r->_surf) - off);
+    }
+    if (rc) rc = (base && row) ? nvmtl_vk_image_write(r->_q, &r->_i, base, row) : -1;
     if (!rc && r->_i.bpp == 4) { char tag[24]; snprintf(tag, sizeof tag, "in%u-", (unsigned)IOSurfaceGetID(r->_surf)); nvmtl_frame_dump(tag, base, row, r->_i.w, r->_i.h); }
     IOSurfaceUnlock(r->_surf, kIOSurfaceLockReadOnly, NULL);
     if (rc) { nvlog("G13 surface-in: upload FAILED (%ux%u) — retried at the next use", r->_i.w, r->_i.h); return; }
diff --git a/plugin/nvmtl_vk.c b/plugin/nvmtl_vk.c
index b0566bd..0646555 100644
--- a/plugin/nvmtl_vk.c
+++ b/plugin/nvmtl_vk.c
@@ -6169,6 +6169,37 @@ static void nvmtl_copy_from_surface(void *dst, const void *src, size_t n)
     memcpy(dst, src, n);
 }
 
+// Surface-in without a CPU copy: the IOSurface's own pages (locked by the caller for the whole call) are imported as
+// host memory (VK_EXT_external_memory_host) and the GPU copies them into the image. Uncompressed formats only; the
+// caller falls back to nvmtl_vk_image_write when this returns non-zero. base/alloc: the plane's base address and the
+// page-rounded bytes from it to the end of the surface.
+int nvmtl_vk_image_write_host(nvk_queue *q, nvk_image *img, void *base, size_t row_bytes, size_t alloc)
+{
+    const size_t bpp = img->bpp ? img->bpp : 4;
+    if (img->bw > 1 || img->bh > 1 || !row_bytes || row_bytes % bpp || row_bytes < (size_t)img->w * bpp) return -1;
+    if (g_host_align) alloc = (alloc + g_host_align - 1) & ~(g_host_align - 1);
+    if ((size_t)img->h * row_bytes > alloc) return -1;
+    nvk_buffer hb;
+    if (nvmtl_vk_buffer_import_host(base, alloc, &hb)) return -1;
+    nvk_cmdbuf c;
+    if (nvmtl_vk_cmd_begin(q, &c)) { nvmtl_vk_buffer_destroy(&hb); return -1; }
+    VkImageSubresourceRange range = { nvmtl_barrier_aspect(img), 0, 1, 0, 1 };
+    VkImageMemoryBarrier toDst = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL, 0, VK_ACCESS_TRANSFER_WRITE_BIT,
+        VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+        VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)img->img, range };
+    pvkCmdPipelineBarrier(c.cb, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL, 1, &toDst);
+    VkBufferImageCopy bic = { 0, (uint32_t)(row_bytes / bpp), 0, { nvmtl_copy_aspect(img), 0, 0, 1 }, { 0, 0, 0 }, { img->w, img->h, 1 } };
+    pvkCmdCopyBufferToImage(c.cb, (VkBuffer)hb.buf, (VkImage)img->img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &bic);
+    VkImageMemoryBarrier toRead = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, NULL,
+        VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+        VK_QUEUE_FAMILY_IGNORED, VK_QUEUE_FAMILY_IGNORED, (VkImage)img->img, range };
+    pvkCmdPipelineBarrier(c.cb, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, 0, 0, NULL, 0, NULL, 1, &toRead);
+    img->layout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    const int rc = nvmtl_vk_submit_wait_at(&c, "surface upload (host pages)");
+    nvmtl_vk_buffer_destroy(&hb);
+    return rc;
+}
 int nvmtl_vk_image_write(nvk_queue *q, nvk_image *img, const void *src, size_t row_bytes)
 {
     const size_t bpp = img->bpp ? img->bpp : 4;
diff --git a/plugin/nvmtl_vk.h b/plugin/nvmtl_vk.h
index 29a80dc..7055233 100644
--- a/plugin/nvmtl_vk.h
+++ b/plugin/nvmtl_vk.h
@@ -213,6 +213,7 @@ extern void (*nvmtl_pre_release_hook)(void *);
 extern void (*nvmtl_pre_submit_hook)(void);
 int  nvmtl_vk_image_read(nvk_queue *q, nvk_image *img, void *dst, size_t row_bytes);
 int  nvmtl_vk_image_write(nvk_queue *q, nvk_image *img, const void *src, size_t row_bytes);
+int  nvmtl_vk_image_write_host(nvk_queue *q, nvk_image *img, void *base, size_t row_bytes, size_t alloc);
 int  nvmtl_vk_copy_buffer(nvk_queue *q, nvk_buffer *src, size_t srcOff, nvk_buffer *dst, size_t dstOff, size_t size);
 int  nvmtl_vk_image_create_mips(uint32_t w, uint32_t h, int bgra, uint32_t mips, nvk_image *out);
 int  nvmtl_vk_image_create_ex(uint32_t w, uint32_t h, uint32_t vkfmt, uint32_t bpp, int a8, uint32_t mips, nvk_image *out);
-- 
