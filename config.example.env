# Copy to config.env (gitignored) and adjust. Sourced (bash) by the scripts on the workstation and on the KVM host.

# --- KVM host ---------------------------------------------------------------------------------------------------
KVM_HOST=edi                          # ssh alias of the KVM host, used by workstation-side scripts
VM_DIR=/srv/vms/tahoe                 # VM folder on the host: disks, OpenCore image, OVMF vars, logs, sockets
QEMU_DIR=/opt/qemu-11.1.2             # QEMU 11 install on the host (host/qemu-build); run.sh and libvirt use it
GPU=0000:0e:00.0                      # GPU function to pass through (bound to vfio-pci) ...
GPU_AUDIO=0000:0e:00.1                # ... and its HDMI audio function (same IOMMU group)
GPU_BAR1_LOG2MB=12                    # BAR1 size set before start, log2(MB): 12 = 4 GB (what macOS + the driver need)
GPU_BAR1_RESTORE_LOG2MB=              # libvirt hook: size to put back after the VM stops (e.g. 15 = 32 GB); empty = leave
LAN_LISTEN="192.168.1.10"             # host addresses where macOS Screen Sharing is exposed for VNC viewers (tcp-forward.py)
SSH_FWD_PORT=2223                     # host 127.0.0.1:SSH_FWD_PORT -> guest :22
SCREENSHARING_FWD_PORT=5931           # host 127.0.0.1:PORT -> guest :5900 (and LAN_LISTEN:PORT through tcp-forward.py)
VNC_DISPLAY=30                        # run.sh without GPU: QEMU's own VNC on :VNC_DISPLAY (port 5900 + N)

# --- the VM -----------------------------------------------------------------------------------------------------
VM_NAME=tahoe-4090                    # libvirt domain name
CPU=amd                               # intel (install, emulated Intel CPU) | amd (-cpu host + AMD_Vanilla patches)
OC=OpenCore-amd-gpu-debug.img         # OpenCore disk image in VM_DIR (opencore/build-esp.sh)
DISK=tahoe.qcow2                      # macOS disk in VM_DIR
MEM=32G
SMP=16
CORES=8                               # cores= of -smp; the AMD_Vanilla core-count patch must match it (make-config.py --cores)
GPU_PASSTHROUGH=1                     # run.sh: 1 = pass the GPU through (no emulated display), 0 = vmware-svga + VNC

# --- guest ------------------------------------------------------------------------------------------------------
GUEST_SSH=tahoe                       # ssh alias of the guest (ProxyJump KVM_HOST -> 127.0.0.1:SSH_FWD_PORT)
GUEST_USER=user                       # macOS account (auto-login, GUI-session commands)
